{
  "id": "/app",
  "name": "Formwright",
  "short_name": "Formwright",
  "description": "The AI design engineer for mechanical teams: verified, editable parametric CAD.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#23272E",
  "background_color": "#23272E",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "business",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Projects",
      "short_name": "Projects",
      "url": "/app/projects",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Design Office",
      "short_name": "Office",
      "url": "/app/office",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/app/open-file",
      "accept": {
        "application/vnd.formwright.part+zip": [
          ".fwpart"
        ],
        "application/vnd.formwright.assembly+zip": [
          ".fwasm"
        ],
        "application/vnd.formwright.drawing+zip": [
          ".fwdrw"
        ],
        "application/vnd.formwright.program+zip": [
          ".fwprog"
        ],
        "application/vnd.formwright.render+zip": [
          ".fwrender"
        ],
        "application/vnd.formwright.manufacturing+zip": [
          ".fwmfg"
        ],
        "application/vnd.formwright.calculation+zip": [
          ".fwcalc"
        ],
        "application/vnd.formwright.print+zip": [
          ".fwprint"
        ],
        "application/vnd.formwright.read+zip": [
          ".fwread"
        ]
      }
    }
  ]
}